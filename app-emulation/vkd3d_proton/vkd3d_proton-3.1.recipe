SUMMARY="Direct3D 12 on Vulkan, for Wine"
DESCRIPTION="vkd3d-proton implements Direct3D 12 on Vulkan. In a Wine prefix it replaces \
Wine's own d3d12 and d3d12core, and Direct3D 12 programs then draw through Vulkan. It is the \
Direct3D 12 to use beside DXVK, whose dxgi Wine's own d3d12 does not work with.

This package holds the 32- and 64-bit DLLs, built on RenkuOS, and a Winetricks verb that \
installs them into a prefix:
    winetricks /boot/system/data/vkd3d-proton/vkd3d_proton_renkuos.verb
Winetricks' own 'vkd3d' verb downloads the latest release instead."
HOMEPAGE="https://github.com/HansKristian-Work/vkd3d-proton"
COPYRIGHT="2016-2024 the vkd3d-proton project authors
	2019-2022 Hans-Kristian Arntzen for Valve Corporation
	2025 Philip Rebohle
	2019-2020 Baldur Karlsson
	2014-2016 LunarG, Inc., Google, Inc."
LICENSE="GNU LGPL v2.1
	MIT
	BSD (3-clause)"
REVISION="1"
SOURCE_URI="https://github.com/HansKristian-Work/vkd3d-proton/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="7e4b07e041b0d3330026190270bdd0be42e0fbf674a16828e8a77462f2be59a0"
SOURCE_FILENAME="vkd3d-proton-$portVersion.tar.gz"
SOURCE_DIR="vkd3d-proton-$portVersion"
PATCHES="vkd3d_proton-$portVersion.patchset"
ADDITIONAL_FILES="vkd3d_proton_renkuos.verb"
# vkd3d-proton's submodules, at the commits v3.1 pins. A release has no source tarball with them.
vulkanHeadersRev="ee2ec5fd83dafce291024683b50dc89219333076"
SOURCE_URI_2="https://github.com/KhronosGroup/Vulkan-Headers/archive/$vulkanHeadersRev.tar.gz"
CHECKSUM_SHA256_2="df7a152381a7fdaf98e36de7716b8d6d6ead776764bc76d1a1aef9049d1bca89"
SOURCE_FILENAME_2="Vulkan-Headers-$vulkanHeadersRev.tar.gz"
SOURCE_DIR_2="Vulkan-Headers-$vulkanHeadersRev"
spirvHeadersRev="f88a2d766840fc825af1fc065977953ba1fa4a91"
SOURCE_URI_3="https://github.com/KhronosGroup/SPIRV-Headers/archive/$spirvHeadersRev.tar.gz"
CHECKSUM_SHA256_3="028424e4934f2ed8567319939e79d0a87e529ac7c504501b8b406f98598bdadd"
SOURCE_FILENAME_3="SPIRV-Headers-$spirvHeadersRev.tar.gz"
SOURCE_DIR_3="SPIRV-Headers-$spirvHeadersRev"
dxilSpirvRev="8b48f0e0392d76be4fdcea2a3ba3ea99dddaae5b"
SOURCE_URI_4="https://github.com/HansKristian-Work/dxil-spirv/archive/$dxilSpirvRev.tar.gz"
CHECKSUM_SHA256_4="9df5d5c8c322b65f39f6c76ef0974e37fdba07136b28174fc9a09f56f1dfdc08"
SOURCE_FILENAME_4="dxil-spirv-$dxilSpirvRev.tar.gz"
SOURCE_DIR_4="dxil-spirv-$dxilSpirvRev"
# dxil-spirv's own submodules that the build uses: SPIRV-Headers and dxbc-spirv, and that one's
# SPIRV-Headers. (Its SPIRV-Cross and SPIRV-Tools are for its command-line tools only.)
dxilSpirvHeadersRev="c63848ecf2200425511319fd8bf2c17b751e501e"
SOURCE_URI_5="https://github.com/KhronosGroup/SPIRV-Headers/archive/$dxilSpirvHeadersRev.tar.gz"
CHECKSUM_SHA256_5="e62af3ae847d3dd4b4cf87ee70a3180bd527594c9f18c20f7434224a2ab20139"
SOURCE_FILENAME_5="SPIRV-Headers-$dxilSpirvHeadersRev.tar.gz"
SOURCE_DIR_5="SPIRV-Headers-$dxilSpirvHeadersRev"
dxbcSpirvRev="8dae2d8573af08378c6059aca3d5987da99d20b5"
SOURCE_URI_6="https://github.com/doitsujin/dxbc-spirv/archive/$dxbcSpirvRev.tar.gz"
CHECKSUM_SHA256_6="9d423accde3fa56b3b56fc3778a2a4308ce13a2343cd9945fc4f41899de8fee4"
SOURCE_FILENAME_6="dxbc-spirv-$dxbcSpirvRev.tar.gz"
SOURCE_DIR_6="dxbc-spirv-$dxbcSpirvRev"
dxbcSpirvHeadersRev="c8ad050fcb29e42a2f57d9f59e97488f465c436d"
SOURCE_URI_7="https://github.com/KhronosGroup/SPIRV-Headers/archive/$dxbcSpirvHeadersRev.tar.gz"
CHECKSUM_SHA256_7="5b6f38b430f1c68c7395c570053403da14eb4cecc7fcb4040e7a5248c2f63874"
SOURCE_FILENAME_7="SPIRV-Headers-$dxbcSpirvHeadersRev.tar.gz"
SOURCE_DIR_7="SPIRV-Headers-$dxbcSpirvHeadersRev"

# The DLLs are Windows code, the same for every RenkuOS architecture that runs Wine.
ARCHITECTURES="any"

PROVIDES="
	vkd3d_proton = $portVersion
	"
REQUIRES="
	haiku
	cmd:winetricks
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	llvm_mingw
	cmd:glslang
	cmd:meson
	cmd:ninja
	cmd:x86_64_w64_mingw32_gcc
	cmd:x86_64_w64_mingw32_g++
	cmd:x86_64_w64_mingw32_ar
	cmd:x86_64_w64_mingw32_strip
	cmd:x86_64_w64_mingw32_widl
	cmd:i686_w64_mingw32_gcc
	cmd:i686_w64_mingw32_g++
	cmd:i686_w64_mingw32_ar
	cmd:i686_w64_mingw32_strip
	cmd:i686_w64_mingw32_widl
	"

BUILD()
{
	rmdir khronos/Vulkan-Headers khronos/SPIRV-Headers subprojects/dxil-spirv \
		"$sourceDir4/third_party/spirv-headers" "$sourceDir4/subprojects/dxbc-spirv" \
		"$sourceDir6/submodules/spirv_headers" 2> /dev/null || true
	ln -sfn "$sourceDir2" khronos/Vulkan-Headers
	ln -sfn "$sourceDir3" khronos/SPIRV-Headers
	ln -sfn "$sourceDir4" subprojects/dxil-spirv
	ln -sfn "$sourceDir5" "$sourceDir4/third_party/spirv-headers"
	ln -sfn "$sourceDir6" "$sourceDir4/subprojects/dxbc-spirv"
	ln -sfn "$sourceDir7" "$sourceDir6/submodules/spirv_headers"

	# As vkd3d-proton's package-release.sh builds a release.
	for bits in 64 32; do
		if [ $bits = 64 ]; then dir=x64; else dir=x86; fi
		meson setup --cross-file build-win$bits.txt --buildtype release --strip \
			--prefix "$PWD/install" --bindir $dir --libdir $dir build.$bits
		ninja -C build.$bits $jobArgs
	done
}

INSTALL()
{
	for bits in 64 32; do
		if [ $bits = 64 ]; then dir=x64; else dir=x86; fi
		ninja -C build.$bits install
		mkdir -p "$dataDir/vkd3d-proton/$dir"
		cp install/$dir/*.dll "$dataDir/vkd3d-proton/$dir/"
	done
	cp "$portDir/additional-files/vkd3d_proton_renkuos.verb" "$dataDir/vkd3d-proton/"
}
